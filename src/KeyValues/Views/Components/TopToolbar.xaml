<UserControl x:Class="KeyValues.Views.Components.TopToolbar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converters="clr-namespace:KeyValues.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="60" d:DesignWidth="1000">
    <UserControl.Resources>
        <converters:ThemeIconConverter x:Key="ThemeIconConverter" />
    </UserControl.Resources>
    
    <Border Background="{DynamicResource CardBackgroundBrush}" 
            BorderBrush="{DynamicResource BorderBrush}" 
            BorderThickness="0,0,0,1" 
            Padding="16,12">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- App Logo/Title -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock FontFamily="{StaticResource FluentIcons}" 
                           Text="&#xE8D7;" 
                           FontSize="20" 
                           Foreground="{DynamicResource AccentBrush}" 
                           VerticalAlignment="Center" 
                           Margin="0,0,8,0"/>
                <TextBlock Text="KeyValues" 
                           FontSize="18" 
                           FontWeight="Bold" 
                           VerticalAlignment="Center"/>
                <TextBlock Text="offline vault" 
                           FontSize="11" 
                           Foreground="{DynamicResource TextSecondaryBrush}" 
                           VerticalAlignment="Bottom" 
                           Margin="8,0,0,2"/>
            </StackPanel>

            <!-- Operations Toolbar (Backup, Restore, Import, Theme) -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding ImportCsvCommand}" 
                        Style="{StaticResource ModernButton}" 
                        ToolTip="CSVからアカウントを一括インポートします"
                        Margin="0,0,6,0"
                        Padding="12,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource FluentIcons}" Text="&#xE8B5;" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBlock Text="一括追加" VerticalAlignment="Center" FontSize="12"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding BackupCommand}" 
                        Style="{StaticResource ModernButton}" 
                        ToolTip="現在のデータを別ファイルにバックアップ出力します"
                        Margin="0,0,6,0"
                        Padding="12,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource FluentIcons}" Text="&#xE105;" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBlock Text="バックアップ" VerticalAlignment="Center" FontSize="12"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding RestoreCommand}" 
                        Style="{StaticResource ModernButton}" 
                        ToolTip="バックアップファイルからデータを復元します"
                        Margin="0,0,16,0"
                        Padding="12,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource FluentIcons}" Text="&#xE1A5;" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBlock Text="データ復元" VerticalAlignment="Center" FontSize="12"/>
                    </StackPanel>
                </Button>

                <!-- Windows Hello Toggle -->
                <CheckBox IsChecked="{Binding IsAutoLoginEnabled}" 
                          IsEnabled="{Binding IsWindowsHelloSupported}"
                          Content="Windows Hello 自動ログイン" 
                          VerticalAlignment="Center" 
                          Margin="0,0,16,0"
                          ToolTip="このPCでの生体認証やPINによる自動ロック解除を有効にします"
                          Foreground="{DynamicResource TextSecondaryBrush}"
                          FontSize="11"/>

                <!-- Theme Toggle -->
                <Button Command="{Binding ToggleThemeCommand}" 
                        Style="{StaticResource ModernButton}" 
                        Padding="8"
                        ToolTip="ライト/ダークテーマを切り替えます">
                    <TextBlock FontFamily="{StaticResource FluentIcons}" 
                               FontSize="14" 
                               Text="{Binding IsDarkMode, Converter={StaticResource ThemeIconConverter}, FallbackValue=&#xE706;}"/>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
