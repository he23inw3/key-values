<Window x:Class="KeyValues.Views.MasterPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:KeyValues.Converters"
        Title="KeyValues - 認証" 
        Height="560" Width="500"
        MinHeight="560" MinWidth="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource MainFont}">

    <Window.Resources>
        <local:VisibilityConverter x:Key="VisibilityConverter" />
        <local:InvertedVisibilityConverter x:Key="InvertedVisibilityConverter" />
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Header with theme toggle -->
            <RowDefinition Height="Auto" /> <!-- Icon & Title -->
            <RowDefinition Height="*" />    <!-- Content / Password inputs -->
            <RowDefinition Height="Auto" /> <!-- Actions -->
        </Grid.RowDefinitions>

        <!-- Header theme toggle -->
        <Button Grid.Row="0" 
                x:Name="ThemeToggleButton"
                Style="{StaticResource ModernButton}" 
                Padding="8" 
                HorizontalAlignment="Right" 
                Click="ThemeToggleButton_Click">
            <TextBlock FontFamily="{StaticResource FluentIcons}" 
                       FontSize="16" 
                       x:Name="ThemeToggleIcon" 
                       Text="&#xE708;" /> <!-- Moon (Dark) or Sun (Light) -->
        </Button>

        <!-- Icon and Title -->
        <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,0,0,20">
            <TextBlock FontFamily="{StaticResource FluentIcons}" 
                       FontSize="42" 
                       HorizontalAlignment="Center" 
                       Foreground="{DynamicResource AccentBrush}"
                       Text="&#xE72E;" /> <!-- Lock Icon -->
            <TextBlock FontSize="20" 
                       FontWeight="Bold" 
                       Margin="0,8,0,4" 
                       HorizontalAlignment="Center" 
                       x:Name="TitleTextBlock"
                       Text="{Binding TitleText}" />
            <TextBlock FontSize="12" 
                       Foreground="{DynamicResource TextSecondaryBrush}" 
                       HorizontalAlignment="Center" 
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       x:Name="SubtitleTextBlock"
                       Text="{Binding SubtitleText}" />
        </StackPanel>

        <!-- Password Inputs -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel VerticalAlignment="Center" Margin="10,0">
            <!-- Unlock Mode Input -->
            <Grid x:Name="UnlockPasswordContainer" Visibility="{Binding IsSetupMode, Converter={StaticResource InvertedVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Label Content="マスターパスワード" 
                       Foreground="{DynamicResource TextSecondaryBrush}" 
                       FontSize="11" 
                       Padding="0,0,0,4"/>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!-- Masked input -->
                    <PasswordBox x:Name="UnlockPasswordBox" 
                                 KeyDown="PasswordInput_KeyDown"/>
                    <!-- Unmasked input -->
                    <TextBox x:Name="UnlockTextBox" 
                             Visibility="Collapsed" 
                             KeyDown="PasswordInput_KeyDown"/>
                    
                    <!-- Toggle Show/Hide Button -->
                    <Button Grid.Column="1" 
                            x:Name="ToggleUnlockPasswordVisibilityButton"
                            Style="{StaticResource ModernButton}" 
                            BorderThickness="0,1,1,1" 
                            Padding="12,0" 
                            Click="ToggleUnlockPasswordVisibility_Click">
                        <TextBlock FontFamily="{StaticResource FluentIcons}" 
                                   x:Name="UnlockVisibilityIcon" 
                                   Text="&#xE890;" />
                    </Button>
                </Grid>
                
                <!-- Hint Link Option -->
                <Grid Grid.Row="2" Margin="0,10,0,0">
                    <TextBlock x:Name="ShowHintLink" 
                               Text="ヒントを表示" 
                               Foreground="{DynamicResource AccentBrush}" 
                               Cursor="Hand" 
                               FontSize="11" 
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               MouseDown="ShowHintLink_MouseDown"/>
                </Grid>
            </Grid>

            <!-- Setup Mode Inputs -->
            <StackPanel x:Name="SetupPasswordContainer" Visibility="{Binding IsSetupMode, Converter={StaticResource VisibilityConverter}}">
                <!-- Password 1 -->
                <Label Content="新規マスターパスワード" 
                       Foreground="{DynamicResource TextSecondaryBrush}" 
                       FontSize="11" 
                       Padding="0,0,0,4"/>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <PasswordBox x:Name="SetupPasswordBox1" 
                                 KeyDown="PasswordInput_KeyDown"/>
                    <TextBox x:Name="SetupTextBox1" 
                             Visibility="Collapsed" 
                             KeyDown="PasswordInput_KeyDown"/>
                    <Button Grid.Column="1" 
                            x:Name="ToggleSetupVisibility1"
                            Style="{StaticResource ModernButton}" 
                            BorderThickness="0,1,1,1" 
                            Padding="12,0" 
                            Click="ToggleSetupVisibility1_Click">
                        <TextBlock FontFamily="{StaticResource FluentIcons}" 
                                   x:Name="SetupVisibilityIcon1" 
                                   Text="&#xE890;" />
                    </Button>
                </Grid>

                <!-- Password 2 (Confirm) -->
                <Label Content="パスワード（確認用）" 
                       Foreground="{DynamicResource TextSecondaryBrush}" 
                       FontSize="11" 
                       Padding="0,0,0,4"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <PasswordBox x:Name="SetupPasswordBox2" 
                                 KeyDown="PasswordInput_KeyDown"/>
                    <TextBox x:Name="SetupTextBox2" 
                             Visibility="Collapsed" 
                             KeyDown="PasswordInput_KeyDown"/>
                    <Button Grid.Column="1" 
                            x:Name="ToggleSetupVisibility2"
                            Style="{StaticResource ModernButton}" 
                            BorderThickness="0,1,1,1" 
                            Padding="12,0" 
                            Click="ToggleSetupVisibility2_Click">
                        <TextBlock FontFamily="{StaticResource FluentIcons}" 
                                   x:Name="SetupVisibilityIcon2" 
                                   Text="&#xE890;" />
                    </Button>
                </Grid>
                
                <!-- Password Hint (Optional) -->
                <TextBlock Text="パスワードのヒント（任意 - 他人に見られるためヒントのみ）" 
                           Foreground="{DynamicResource TextSecondaryBrush}" 
                           FontSize="11" 
                           Margin="0,8,0,4"
                           TextWrapping="Wrap"/>
                <TextBox x:Name="SetupHintTextBox" 
                         Margin="0,0,0,12"
                         Text="{Binding PasswordHint, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="他者に見られる可能性があるため、パスワードそのものは書かないでください"/>

                <!-- Windows Hello Option -->
                <CheckBox x:Name="SetupAutoLoginCheckBox" 
                          Content="このPCで Windows Hello 自動ログインを有効にする" 
                          Foreground="{DynamicResource TextSecondaryBrush}"
                          FontSize="11"
                          Margin="0,4,0,0"
                          IsChecked="{Binding IsAutoLoginEnabled}"
                          Visibility="{Binding IsWindowsHelloSupported, Converter={StaticResource VisibilityConverter}}"/>
            </StackPanel>

            <!-- Error message display -->
            <TextBlock x:Name="ErrorMessageTextBlock" 
                       Foreground="{DynamicResource DangerBrush}" 
                       FontSize="11" 
                       Margin="0,8,0,0" 
                       HorizontalAlignment="Center" 
                       TextAlignment="Center" 
                       TextWrapping="Wrap" 
                       Text="{Binding ErrorMessage}"
                       Visibility="{Binding IsErrorMessageVisible, Converter={StaticResource VisibilityConverter}}" />
        </StackPanel>
        </ScrollViewer>

        <!-- Actions -->
        <Grid Grid.Row="3" Margin="0,16,10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="ResetButton" 
                    Grid.Column="0"
                    Content="パスワードを忘れた場合（リセット）" 
                    Style="{StaticResource ModernButton}" 
                    Foreground="{DynamicResource DangerBrush}" 
                    HorizontalAlignment="Left"
                    Visibility="{Binding IsSetupMode, Converter={StaticResource InvertedVisibilityConverter}}"
                    Click="ResetButton_Click"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" 
                        Content="キャンセル" 
                        Style="{StaticResource ModernButton}" 
                        Margin="0,0,8,0" 
                        Click="CancelButton_Click"/>
                <Button x:Name="SubmitButton" 
                        Content="{Binding SubmitButtonText}" 
                        Style="{StaticResource AccentButton}" 
                        Click="SubmitButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
